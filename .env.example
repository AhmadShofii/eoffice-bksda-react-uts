# Base URL untuk API Backend (CodeIgniter 4 / Express / dsb)
VITE_API_BASE_URL=http://localhost:8080/api

# Mode Mock API (true = fetch data dari file mock JSON di /mock/*.json, false = konek ke backend asli)
# Berguna saat pengujian UTS jika backend belum dijalankan
VITE_USE_MOCK=true

# Pengaturan Aplikasi
VITE_APP_NAME="E-Office BKSDA Jawa Tengah"
VITE_APP_ENV=development
